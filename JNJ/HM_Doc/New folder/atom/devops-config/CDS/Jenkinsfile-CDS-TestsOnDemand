#!/usr/bin/env groovy _

@NonCPS
def setJobDescription(String description) {
    currentBuild.description = description
}

pipeline {
    agent {
        node {
            label 'ubuntu'
            customWorkspace "${env.JENKINS_HOME}/workspace/${env.JOB_NAME}/${env.BUILD_NUMBER}"
        }
    }
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        skipDefaultCheckout true
        timeout(time: 17, unit: 'HOURS')
        timestamps()
    }
    parameters {
        string name: 'EMPOWER_VM_IP', defaultValue: '', description: "Enter the IP of the Empower VM.", trim: true
        string name: 'TEST_FILTER', defaultValue: '', description: "Enter the tag of the test(s) you want to run - Please note, this pipeline doesn't do any validation on this string.", trim: true
        string name: 'TIMEOUT', defaultValue: '57600', description: "Maximum test execution time in seconds after which test execution will be forcibly stopped and marked as failed", trim: true
    }

    environment {
        BITBUCKET_CREDS = credentials('codeta03-readonly')
        GENERATED_FOLDER_NAME = new Date().format('MM_dd_yyyy_HH_mm_ss')
    }

    stages {
        stage('Check for fail fast') {
            steps {
                script {
                    if (BUILD_NUMBER == '1')
                        error('Aborting the first build, due to auto propagated parameters')

                    if (!params.EMPOWER_VM_IP)
                        error("You need to provide the EMPOWER_VM_IP parameter!")

                    if (!params.TEST_FILTER)
                        error("You need to provide the TEST_FILTER parameter!")

                    if (!params.TIMEOUT.isInteger())
                        error('Timeout parameter should be positive integer')

                    env.ATOM_FOLDER = env.GENERATED_FOLDER_NAME

                    println """Starting CDS Pipeline using the following parameters:
                    EMPOWER_VM_IP: ${params.EMPOWER_VM_IP} \n
                    TEST_FILTER: ${params.TEST_FILTER} \n
                    ATOM_FOLDER: ${env.ATOM_FOLDER}
                    """

                    setJobDescription("<html><ul><li>EMPOWER_VM_IP: ${params.EMPOWER_VM_IP}</li><li>TEST_FILTER: ${params.TEST_FILTER}</li></ul></html>")
                }
            }
        }
        stage('Checkout repositories') {
            steps {
                dir('atom') {
                    checkout scm
                }
                dir("piper-runner") {
                    git branch: "master", credentialsId: "codeta03-readonly", url: 'https://code.waters.com/bitbucket/scm/devops/piper-runner.git'
                }
            }
        }

        stage('IntegrationTest') {
            steps {
                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', message: "Tests execution failed.") {
                    script {
                        def command = []
                        runTests(env.ATOM_FOLDER, env.EMPOWER_VM_IP, env.TIMEOUT, command.join(" "))
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'atom/results/*.*', fingerprint: true
                    allure includeProperties: false, jdk: '', results: [[path: 'atom/results/allure-results/']]
                    junit allowEmptyResults: true, testResults: "atom/results/pytest-results/*.*"
                    sh "ps"
                    sh "pkill xvfb-run"
                }
            }
        }
    }
    post {
        // Clean after build
        always {
            script {
                cleanWs()
            }
        }
    }
}

def runTests(String atomFolderName, String host, String timeout, String extraArguments = null) {
        withCredentials([usernamePassword(credentialsId: 'user', passwordVariable: 'pass', usernameVariable: 'user')]) {
        //Running with extra arguments if provided
        sh label: "Install required linux libraries", script: "sudo apt-get update && sudo apt-get --fix-broken install -y && sudo apt-get install -y python3-pip python3-dev python3.8-venv xvfb freerdp2-x11"
        sh label: "Start RDP session to ${host}", script: "xvfb-run -a xfreerdp /cert-ignore /u:${env.user} /p:${env.pass} /v:${host} /size:1920x1080 > /dev/zero &"
        sh label: 'IntegrationTest', returnStdout: false, script: """
            python3 ./piper-runner/runner.py --project-home ./atom --config_file ./atom/devops-config/CDS/config-CDS-TestsOnDemand.xml --consumer_variables host_atom_folder=${atomFolderName} app_commit=$env.GIT_COMMIT host=${host} test_filter="${params.TEST_FILTER}" extra_arguments=${extraArguments} timeout=${timeout}
            """
        }
    }
